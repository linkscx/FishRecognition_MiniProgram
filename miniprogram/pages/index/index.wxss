page {
  background-color: #ffffff;
}

.data form{
  height: auto;
  background-color: #f2f2f2;
  margin: 10px;
}
.data{
  width: 80vw;
}
.top-title {
  margin-top: 10rpx;
  height: 40rpx;
  line-height: 30rpx;
  font-size: 40rpx;
  font-weight: bold;
  color: rgba(51, 51, 51, 1);
}
.form-item {
  height: 100rpx;
  border-bottom: 1rpx solid #e3e3e3;
  display: flex;
  align-items: center; 
  justify-content: left; /* 水平居中 */
}
.left{
  width: 35%;
  line-height: 100rpx;
  font-size: 35rpx;
  font-weight: bold;
  color: rgba(102, 102, 102, 1);
}
.right-input {
  width: 35%;
  height: auto;
  font-size: 30rpx;
  line-height: 100rpx;
  font-weight: 500;
  color: rgb(14, 1, 1);
  text-align: left;
  margin-left: 15%;
}
.unit {
  width: 8%;
  font-size: 30rpx;
  line-height: 100rpx;
  font-weight: 500;
  color: rgba(170, 170, 170, 1);
}
.shape-box {
  width: 50%;
  font-size: 35rpx;
  font-weight: bold;
  color: rgba(51, 51, 51, 1);
  margin-left: 2%;
}
.shape{
  margin-left: 10%;
}
.ratio{
  height: auto;
  font-size: 30rpx;
  line-height: 100rpx;
  font-weight: 500;
  color: rgba(170, 170, 170, 1);
  margin-left: -60px;
}
.radio-item:nth-child(2) {
  margin-left: 15%;
}
.form-item:last-child { 
  border-bottom: 0rpx solid #e3e3e3;
}
.form-item-hidden {
  display: none;
}
.bottom {
  /* background-color: #f6f6f6; */
  display: flex;
  /* 子元素在主轴上分散对齐 */
  justify-content: space-between; 
  /* 子元素在交叉轴上居中对齐 */
  align-items: center; 
  height: 100rpx;
  margin-top: 5px;
} 
.fill{
  width: 5vw;
}
.save-btn, .export-btn, .forecast-btn{
  color: #596f99;
  border: 3rpx solid #596f99;
  border-radius: 80rpx;
  font-size: 34rpx;
}
.save-btn, .export-btn, .forecast-btn{
  flex: 1; /* 让按钮有弹性，可以扩展填充空间 */
}

/* 按钮的点击效果 */
.hover-class-1 {
  top: 3rpx;
  background-color: #e7f5ff;
}
.item1{
  padding-left: 0%;
}
.item2{
  padding-left: 12%;
}
.item3{
  padding-left: 0%;
}
.item4{
  padding-left: 0%;
}
.loading-tip {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  padding: 10px 20px;
  background: rgba(0, 0, 0, 0.7);
  color: white;
  border-radius: 4px;
  z-index: 999;
}

/* 1. 所有 radio 的基础样式（未选中时） */
radio .wx-radio-input {
  border-color: rgba(204, 204, 204, 0.644) !important;
  background-color: transparent !important;
}

/* 2. 选中的 "是" 的样式 */
/* 2.1 设置选中时的按钮填充色（背景色） */
radio[checked].item-yes .wx-radio-input {
  background-color: #00B42A !important; /* 绿色背景 */
  border-color: #00B42A !important;    /* 边框也设为绿色，看起来更统一 */
}
/* 2.2 设置选中时的对勾颜色 */
radio[checked].item-yes .wx-radio-input::before {
  color: #FFFFFF !important; /* 白色对勾 */
}

/* 3. 选中的 "否" 的样式 */
/* 3.1 设置选中时的按钮填充色（背景色） */
radio[checked].item-no .wx-radio-input {
  background-color: #F53F3F !important; /* 红色背景 */
  border-color: #F53F3F !important;     /* 边框也设为红色 */
}
/* 3.2 设置选中时的对勾颜色 */
radio[checked].item-no .wx-radio-input::before {
  color: #FFFFFF !important; /* 白色对勾 */
}