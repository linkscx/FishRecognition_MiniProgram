page {
  background-color: #ffffff;
}

.data form{
  height: auto;
  background-color: #f2f2f2;
  margin: 10px;
}
.data{
  width: 80vw;
}
.top-title {
  margin-top: 10rpx;
  height: 30rpx;
  line-height: 30rpx;
  font-size: 30rpx;
  font-weight: bold;
  color: rgba(51, 51, 51, 1);
}
.form-item {
  height: 100rpx;
  border-bottom: 1rpx solid #e3e3e3;
  display: flex;
  align-items: center; 
  justify-content: center; /* 水平居中 */
}
.left{
  width: 35%;
  line-height: 100rpx;
  font-size: 30rpx;
  font-weight: bold;
  color: rgba(102, 102, 102, 1);
}
.right-input {
  width: 35%;
  height: auto;
  font-size: 30rpx;
  line-height: 100rpx;
  font-weight: 500;
  color: rgba(170, 170, 170, 1);
  text-align: center;
}
.unit {
  width: 8%;
  font-size: 30rpx;
  line-height: 100rpx;
  font-weight: 500;
  color: rgba(170, 170, 170, 1);
}
.shape-box {
  width: 50%;
  font-size: 30rpx;
  font-weight: bold;
  color: rgba(51, 51, 51, 1);
  margin-left: 0%;
}
.shape{
  margin-left: 5%;
}
.ratio{
  
  height: auto;
  font-size: 30rpx;
  line-height: 100rpx;
  font-weight: 500;
  color: rgba(170, 170, 170, 1);
  text-align: left;
}
.radio-item:nth-child(2) {
  margin-left: 15%;
}
.form-item:last-child { 
  border-bottom: 0rpx solid #e3e3e3;
}
.bottom {
  /* background-color: #f6f6f6; */
  display: flex;
  /* 子元素在主轴上分散对齐 */
  justify-content: space-between; 
  /* 子元素在交叉轴上居中对齐 */
  align-items: center; 
  height: 100rpx;
} 
.fill{
  width: 5vw;
}
.save-btn, .export-btn, .forecast-btn{
  color: #596f99;
  border: 3rpx solid #596f99;
  border-radius: 80rpx;
  font-size: 34rpx;
}
.save-btn, .export-btn, .forecast-btn{
  flex: 1; /* 让按钮有弹性，可以扩展填充空间 */
}

/* 按钮的点击效果 */
.hover-class-1 {
  top: 3rpx;
  background-color: #e7f5ff;
}
.item1{
  padding-right: 10%;
}
.item2{
  padding-left: 10%;
}




