<view class="container">
  <view class="head__search">
    <view class="search__row">
      <text class="text">请输入查询个数：</text>
      <icon class="icon-small" type="search" size="14"></icon>
      <input class="search__input" type="number" confirm-type="search" placeholder="请输入个数" 
      bindinput="numberInput"/>
      <view class="number_text">
        <text>记录总数：{{countResult}}</text>
      </view>
    </view>
    <view class="search__row">
      <text class="text">请选择查询体型：</text>
      <view class="shape">
        <radio-group name="shape" bindchange="changeShape">
          <radio class="radio-item" value="0" color="#DBB975">正常</radio>
          <radio class="radio-item" value="1" color="#DBB975">瘦身</radio>
          <radio class="radio-item" value="2" color="#DBB975" checked="true">全部</radio>
        </radio-group>
      </view>
    </view>
    <view class="search__row">
      <picker class="picker" mode="date" value="{{sdate}}" start="2020-09-01" end="2050-09-01" bindchange="bindSDateChange" bindcancel="bindSDateCancel">
        <view>
          开始日期: {{sdate}}
        </view>
      </picker>
      <picker class="picker" mode="date" value="{{edate}}" start="2020-09-01" end="2050-09-01" bindchange="bindEDateChange" bindcancel="bindEDateCancel">
        <view>
          结束日期: {{edate}}
        </view>
      </picker>
    </view>
  </view>
  <view class="head___btn">
    <view class="btn_inquire">
      <button type="primary" bind:tap="search">查 询</button>
    </view>
    <view class="btn_export">
      <button type="primary" bind:tap="export">导 出</button>
    </view>
    <view class="btn_delete">
      <button type="primary" bind:tap="delete">删 除</button>
    </view>
    
  </view>
  <view class="table__box">
    <scroll-view class="table__scroll" scroll-y scroll-x style="height:{{totalHeight}}px;" bindscrolltolower="handleScrollToLower">
      <view class="table__scroll__view">
        <view class="table__header">
          <view class="table__header__item" wx:for="{{headList}}" wx:key="index">{{item.title}}</view>
        </view>
        <view class="table__content">
          <view class="table__content__line" wx:for="{{patternList}}" wx:key="index" wx:for-item="patternItem">
            <view class="table__content__line__item">{{patternItem._image_name}}</view>
            <view class="table__content__line__item">{{patternItem.shape}}</view>
            <view class="table__content__line__item">{{patternItem.probability}}</view>
            <view class="table__content__line__item final">{{patternItem._image_path}}</view>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>
</view>