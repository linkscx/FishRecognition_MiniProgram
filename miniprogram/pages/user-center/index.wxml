<!--pages/login/index.wxml-->
<block wx:if="{{isLogin}}">
  <!-- 登录区域 -->
  <view class="login-container">
    <image src="/images/contact-filled.png" class="contact-filled" mode="widthFix"></image>
    <button class="btn-login" bindtap="goLogin">一键登录</button>
    <text class="tip-text">登录后尽享更多功能</text>
  </view>
</block>
<block wx:else>
  <!-- 头像昵称区域 -->
  <view class="top-box">
    <image src="{{avatarUrl}}" class="avatar"></image>
    <view class="nickname">{{nickName}}</view>
  </view>
  <!-- 面板区域 -->
  <view class="panel">
    <view class="panel-list-item">
      <text>意见反馈</text>
      <image src="/images/arrow.png"></image>
    </view>
    <view class="panel-list-item" bindtap="setting">
      <text>设置</text>
      <image src="/images/arrow.png"></image>
    </view>
    <view class="panel-list-item" bindtap="logout">
      <text>退出登录</text>
      <image src="/images/arrow.png"></image>
    </view>
  </view>
</block>

